  "private": true,
  "type": "module",
  "description": "Ropeworks Training Studio — iPad-friendly jump rope training planner",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
