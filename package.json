  },
  "devDependencies": {
    "@fontsource/exo": "^5.2.8",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.12"
  }
